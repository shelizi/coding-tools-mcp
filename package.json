{
  "name": "coding-tools-mcp-desktop",
  "version": "0.1.34",
  "description": "Coding Tools MCP desktop client",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "predesktop": "npm run version:sync",
    "desktop": "tauri dev",
    "predesktop:build": "npm run version:sync",
    "desktop:build": "tauri build --features custom-protocol",
    "desktop:build:nsis": "npm run version:sync && tauri build --features custom-protocol --bundles nsis",
    "desktop:build:macos": "npm run version:sync && tauri build --features custom-protocol --target universal-apple-darwin --bundles dmg",
    "desktop:build:macos:app": "npm run version:sync && tauri build --features custom-protocol --target universal-apple-darwin --bundles app,dmg",
    "desktop:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "start": "tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "verify:fast": "node scripts/verify-frontend.mjs",
    "verify": "npm run verify:fast && npm run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "rust:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust-check.ps1",
    "rust:check:headless": "cargo check --manifest-path src-tauri/Cargo.toml --no-default-features --lib && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --test headless_core && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib task_runtime::headless::tests",
    "rust:fmt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rustfmt-changed.ps1",
    "rust:fmt:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rustfmt-changed.ps1 -Check",
    "rust:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-fast.ps1",
    "rust:test:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-full.ps1",
    "rust:benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark-runtime.ps1",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:patch": "npm version patch --no-git-tag-version && npm run version:sync",
    "pretauri": "npm run version:sync",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@lucide/svelte": "^0.487.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
