{
  "name": "@coding-tools/node-agent",
  "version": "0.29.8",
  "private": true,
  "type": "module",
  "codingTools": {
    "clientVersion": "0.1.40"
  },
  "files": [
    "dist",
    "scripts/test-production-wss.mjs",
    "README.md"
  ],
  "bin": {
    "coding-tools-mcp-node": "dist/cli.js"
  },
  "scripts": {
    "build:server": "node scripts/clean-server-dist.mjs && tsc -p tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "dev:ui": "node scripts/build-ui.mjs --watch",
    "build": "npm run build:server && npm run build:ui",
    "start": "node dist/cli.js",
    "test": "npm run build:server && node --import ./test/setup.mjs --test test/*.test.mjs",
    "test:full": "npm run build && node --import ./test/setup.mjs --test test/*.test.mjs",
    "test:ui": "npm run build:ui",
    "test:wss:production": "npm run build:server && node scripts/test-production-wss.mjs",
    "sync:rust-contract": "node scripts/sync-rust-catalog.mjs",
    "check:rust-contract": "node scripts/sync-rust-catalog.mjs --check",
    "check:client-version": "node ../../scripts/sync-version.mjs --check",
    "check:parity-todos": "node ../../scripts/check-node-agent-parity.mjs",
    "check:ui-parity": "node ../../scripts/check-node-agent-ui-parity.mjs",
    "check:native": "node scripts/check-native.mjs",
    "verify": "npm run test:full && npm run check:native",
    "verify:repo": "npm run verify && npm run check:rust-contract && npm run check:client-version && npm run check:parity-todos && npm run check:ui-parity",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "portable:bundled": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1 -Edition bundled-node",
    "portable:system": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1 -Edition system-node",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.101.4",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "^8.18.1",
    "bootstrap": "5.3.8",
    "css-loader": "7.1.4",
    "mini-css-extract-plugin": "2.10.2",
    "react": "19.2.8",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.8",
    "ts-loader": "9.6.2",
    "typescript": "~5.6.2",
    "webpack": "5.109.2"
  }
}
