# Copy to .env next to compose.example.yml and edit before `docker compose up`.
#   cp services/tunnel-server/.env.example services/tunnel-server/.env
#   cp services/tunnel-server/admin-password.example.txt services/tunnel-server/admin-password.txt

TUNNEL_IMAGE=coding-tools-tunnel-server:local

# Host publish addresses (loopback by default — put Caddy on the same host).
TUNNEL_PUBLIC_BIND=127.0.0.1
TUNNEL_PUBLIC_PORT=8088
TUNNEL_ADMIN_BIND=127.0.0.1
TUNNEL_ADMIN_PORT=8089

# Required: public HTTPS origin used in enrollment links (no trailing slash required).
TUNNEL_PUBLIC_ORIGIN=https://tunnel.example.com

# Admin WebUI login (password is read from a file secret, not from this env file).
TUNNEL_ADMIN_USERNAME=admin
# Relative to services/tunnel-server/ when using compose.example.yml as documented.
TUNNEL_ADMIN_PASSWORD_FILE=./admin-password.txt

RUST_LOG=coding_tools_tunnel_server=info
